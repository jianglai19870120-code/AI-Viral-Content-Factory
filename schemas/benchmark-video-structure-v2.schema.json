{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-video-structure-v2.schema.json",
  "title": "Approved Benchmark FNN Structure V2",
  "type": "object",
  "required": ["schema", "benchmark_case_id", "frameworks"],
  "properties": {
    "schema": {"const": "benchmark-video-structure-v2"},
    "benchmark_case_id": {"type": "string", "pattern": "^[A-Z]+-\\d{3}$"},
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "source_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^F\\d{2}$"},
          "name": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
