{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-video-structure-v3.schema.json",
  "title": "Approved Benchmark FNN Structure V3",
  "type": "object",
  "required": ["schema", "benchmark_case_id", "frameworks", "small_frameworks"],
  "properties": {
    "schema": {"const": "benchmark-video-structure-v3"},
    "benchmark_case_id": {"type": "string", "pattern": "^[A-Z]+-\\d{3}$"},
    "frameworks": {"type": "array", "minItems": 1},
    "small_frameworks": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
