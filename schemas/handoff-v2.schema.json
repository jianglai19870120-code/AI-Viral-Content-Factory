{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-v2.schema.json",
  "title": "AI Traffic Team Handoff v2",
  "type": "object",
  "required": ["schema", "task_id", "pipeline", "stage", "agent", "skill_id", "skill_version", "input_schema", "status", "input", "input_files", "expected_outputs", "output_schema", "audit_required", "audit_status", "execution_binding_sha256"],
  "properties": {
    "schema": {"const": "ai-traffic-handoff-v2"},
    "task_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "pipeline": {"type": "string", "minLength": 1},
    "stage": {"enum": ["execution", "audit"]},
    "agent": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skill_version": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "needs-agent", "needs-user", "completed", "rejected", "blocked"]},
    "input": {"type": "object"},
    "input_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_schema": {"type": "string", "minLength": 1},
    "audit_required": {"type": "boolean"},
    "audit_status": {"enum": ["pending", "needs-agent", "needs-user", "approved", "rejected", "not-required"]},
    "execution_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"file": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
  "additionalProperties": true
}
