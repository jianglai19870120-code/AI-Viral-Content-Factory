{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Final Copy",
  "type": "object",
  "required": ["schema", "structure_four_sha256", "benchmark_sha256", "units"],
  "properties": {
    "schema": {"const": "final-copy-v1"},
    "structure_four_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "benchmark_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "units": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
