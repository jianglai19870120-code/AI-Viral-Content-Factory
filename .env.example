# Optional ima fallback configuration.
# Copy this file to .env.local on your own machine if you need the fallback path.
# Never commit real values.

IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# Optional legacy local gateway only.
# Connected WorkBuddy/Codex ima-mcp tools usually do not expose this HTTP port.
# IMA_MCP_BASE_URL=http://127.0.0.1:18060
