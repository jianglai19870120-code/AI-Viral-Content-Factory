tools/migrate.py
tools/migrate_11to10.py
tools/transform_11to10.py
tools/acc.py
tools/check_audit.py
tools/validate.py
nul

# ---- 会员专享资产红线：目录骨架公开，目录内容不公开 ----
# 任何带「（会员专享）」后缀的目录，只提交 .gitkeep 占位文件。
# 这样 GitHub / SkillHub 能看到会员内容位，但不会包含会员内容本身。
**/*（会员专享）/**
!**/*（会员专享）/.gitkeep

# ---- 工程惯例排除（非业务资产，仅构建/运行产物，任何开源项目均忽略）----
