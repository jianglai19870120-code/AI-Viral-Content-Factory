# ============================================================
# AI爆款内容工厂 — Source Available 发布排除规则
# 默认只发布核心系统源码、合同、空白模板和已确认自有示例。
# 原始资料、个人工作纪实、运行记录及未完成人工权利确认的业务资产不得进入发布包。
# ============================================================

# ---- 安全红线：密钥 / 凭证（用户指定唯一不公开项）----
.env
.env.*
!.env.example
*.local

# ---- WorkBuddy 清洁上传规则 ----
# 上传可复用 memory/automation/配置；排除垃圾、备份、临时、沙箱、候选和验证目录。
.workbuddy/_trash/
.workbuddy/_tmpdel/
.workbuddy/backups/
.workbuddy/sandbox_test*/
.workbuddy/candidates/
.workbuddy/jinju_split/
.workbuddy/v10_verify/
.workbuddy/local_only/
.workbuddy/memory/
.workbuddy/automations/*/memory.md
.workbuddy/cleanup_structures.py
.workbuddy/sync_tables.py
.workbuddy/rename_map.json
.workbuddy/test_struct_*.md

# ---- 改造期历史垃圾与一次性迁移产物：不进入 GitHub / SkillHub / WorkBuddy 包 ----
_trash_expired_*/
tools/_backup_chunk*/
tools/_migrate_*
tools/_verify_*.py
tools/_batch*_entries.json
tools/patch_*.json
tools/rewrites_*.json
